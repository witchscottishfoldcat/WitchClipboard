{
  "name": "witch-clipboard",
  "version": "1.7.3",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "description": "Witch Clipboard — 本地优先的剪贴板管理器：自动分类、来源搜索、关联配置、加密存储与局域网跨设备同步。",
  "keywords": [
    "clipboard",
    "clipboard-manager",
    "windows",
    "arm64",
    "tauri",
    "sqleet",
    "剪贴板"
  ],
  "author": "Thewitchcat <witchscottishfoldcat@gmail.com> (https://www.witchcat.cn)",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "dev:electron": "electron-vite dev",
    "build:electron": "electron-vite build",
    "dev:tauri:web": "vite --config vite.tauri.config.ts --host 127.0.0.1 --port 1421",
    "build:tauri:web": "vite build --config vite.tauri.config.ts",
    "dev:tauri": "npm run dev",
    "build:tauri": "npm run build",
    "preview": "vite preview --config vite.tauri.config.ts --outDir out/tauri-renderer",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "icons": "electron scripts/make-icons.cjs",
    "selftest": "cargo test --manifest-path src-tauri/Cargo.toml --no-fail-fast",
    "selftest:system-clipboard": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/system-clipboard-e2e.ps1",
    "selftest:electron": "npm run rebuild && electron-vite build && electron out/main/index.js --self-test",
    "rebuild": "electron-rebuild -f -w better-sqlite3-multiple-ciphers",
    "dist": "npm run dist:win",
    "dist:win": "tauri build --bundles nsis --target x86_64-pc-windows-msvc",
    "dist:win:arm64": "tauri build --bundles nsis --target aarch64-pc-windows-msvc",
    "dist:win:all": "npm run dist:win && npm run dist:win:arm64",
    "dist:win:release": "tauri build --bundles nsis --target x86_64-pc-windows-msvc --config src-tauri/tauri.release.conf.json",
    "dist:win:arm64:release": "tauri build --bundles nsis --target aarch64-pc-windows-msvc --config src-tauri/tauri.release.conf.json",
    "dist:win:portable": "tauri build --no-bundle --target x86_64-pc-windows-msvc && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-portable.ps1 -Architecture x64",
    "dist:win:arm64:portable": "tauri build --no-bundle --target aarch64-pc-windows-msvc && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-portable.ps1 -Architecture arm64",
    "dist:electron:win": "electron-vite build && electron-builder --win nsis --x64",
    "dist:electron:win:arm64": "electron-vite build && electron-builder --win nsis --arm64",
    "dist:electron:mac": "electron-vite build && electron-builder --mac dmg zip --x64 --arm64",
    "postinstall": "electron-builder install-app-deps"
  },
  "//": "只有主进程运行时真正 require 的模块才放 dependencies——electron-builder 会把它们打进 asar。渲染层依赖已被 Vite 打包，放 devDependencies 免得重复塞一份进安装包。",
  "dependencies": {
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.0",
    "better-sqlite3-multiple-ciphers": "^12.11.1",
    "electron-updater": "^6.8.9",
    "koffi": "^3.1.2",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.10.1",
    "@tanstack/react-virtual": "^3.14.8",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "lucide-react": "^1.27.0",
    "motion": "^12.42.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  }
}
